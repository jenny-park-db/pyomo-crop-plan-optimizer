# Copy to .env (gitignored) and fill in. Read by `make` and scripts/*.py. No secrets: auth is the CLI profile.
# The Databricks CLI profile of the workspace to deploy to (`databricks auth login --host <url> --profile <name>`).
DATABRICKS_CONFIG_PROFILE=pyomo-crop-plan
# UC catalog to use (it must already exist and be visible to you). If empty, the bootstrap derives one from the
# workspace host (some demo workspaces are named fevm-<name> and pre-create <name>_catalog).
CROP_PLAN_CATALOG=
# Comma-separated emails and/or workspace group names that present the demo (make grant).
CROP_PLAN_PRESENTERS=
# Agent deployment name (app agent-bricks-<name>, at most 17 characters). Leave empty for crop-plan-agent.
CROP_PLAN_AGENT_NAME=
