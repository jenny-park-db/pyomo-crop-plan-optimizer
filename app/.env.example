# Copy to .env for `npm run dev` / `npm run typegen`. Values come from `databricks bundle summary -o json`
# (run in bundle/). No secrets: authentication uses the CLI profile.
DATABRICKS_CONFIG_PROFILE=pyomo-crop-plan
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_WAREHOUSE_ID=<warehouse id>
DATABRICKS_GENIE_SPACE_ID=<resources.genie_spaces.crop_plan_results.id>
CROP_PLAN_SOLVE_JOB_ID=<resources.jobs.solve_scenario.id>
CROP_PLAN_STRESS_JOB_ID=<resources.jobs.stress_test.id>
MLFLOW_EXPERIMENT_ID=<resources.experiments.scenarios.id>
CROP_PLAN_CATALOG=pyomo_crop_plan_demo_catalog
CROP_PLAN_SCHEMA=crop_plan
CROP_PLAN_MAP_MODE=tiles
# Local dev has no x-forwarded-email header; runs are attributed to this address (NODE_ENV=development only).
CROP_PLAN_DEV_USER=<your workspace email>
DATABRICKS_APP_PORT=8000
